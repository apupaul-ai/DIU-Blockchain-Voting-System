const translations = {
  bn: {
    academic: "শিক্ষার্থীদের একাডেমিক প্রজেক্ট",
    department: "কম্পিউটার সায়েন্স অ্যান্ড ইঞ্জিনিয়ারিং বিভাগ",
    overview: "সারসংক্ষেপ",
    candidates: "প্রার্থীরা",
    process: "ভোটিং প্রক্রিয়া",
    connect: "ওয়ালেট সংযুক্ত করুন",
    switch: "ভোটার পরিবর্তন করুন",
    eyebrow: "ব্লকচেইনভিত্তিক ভোটিং সিস্টেম",
    heroOne: "আপনার ভোট,",
    heroTwo: "আপনার সিদ্ধান্ত।",
    description: "Ethereum ব্লকচেইন ও MetaMask ব্যবহার করে তৈরি একটি পরীক্ষামূলক ডিজিটাল ভোটিং প্ল্যাটফর্ম। এখানে প্রতিটি ওয়ালেট থেকে একবার ভোট দেওয়া যায় এবং ফলাফল সরাসরি Smart Contract থেকে দেখানো হয়।",
    explore: "প্রার্থীদের দেখুন",
